# Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Providers Config (options: openai, deepgram, gemini, elevenlabs, nvidia)
STT_PROVIDER=openai
LLM_PROVIDER=openai
TTS_PROVIDER=openai

# API Keys
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
DEEPGRAM_API_KEY=your_deepgram_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here

# LLM Configuration
LLM_MODEL=gpt-4o-mini
LLM_SYSTEM_PROMPT="You are a friendly, concise, and highly intelligent conversational voice assistant. Respond naturally and keep answers short, suitable for voice synthesis (1-3 sentences)."
REALTIME_MODEL=gemini-3.1-flash-live-preview
REALTIME_VOICE=alloy

# Agentic Layer Configs
AGENTIC_BASE_URL=http://127.0.0.1:9000
INTERACTION_SHARED_SECRET=your_32_byte_shared_secret_here
CONFIRMATION_SIGNING_KEY=your_separate_32_byte_confirmation_key
# Fixed demo-only OTP. It is validated server-side and never sent to the model.
DEMO_CONFIRMATION_OTP=1111
# Rotating this key requires a migration/re-encryption of stored voice turns.
INTERACTION_DATA_ENCRYPTION_KEY=your_separate_32_byte_interaction_data_key
INTERACTION_STATE_DB=cache_dir/interaction_state.db
INTERACTION_TIMESTAMP_TOLERANCE_SECONDS=300
AGENTIC_TIMEOUT_SECONDS=15

# Server-owned demo identity (replace with real authentication later)
DEMO_USER_ID=evaluation-user
DEMO_TENANT_ID=evaluation-tenant
DEMO_SCOPES=financial:read,financial:write,investment:trade
ALLOW_DEMO_SESSION_BOOTSTRAP=true
SESSION_TTL_SECONDS=3600
VOICE_MEMORY_MAX_USER_TURNS=12
VOICE_MEMORY_MAX_ASSISTANT_TURNS=6
VOICE_MEMORY_CONTEXT_TURNS=8
VOICE_MEMORY_MAX_TEXT_CHARACTERS=2000
SESSION_COOKIE_SECURE=false
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_AUDIO_BYTES=10000000

# TTS Configuration
# OpenAI voices: alloy, echo, fable, onyx, nova, shimmer
# Elevenlabs voices: use Elevenlabs voice IDs (e.g. 21m00Tcm4TlvDq8ikWAM for Rachel)
TTS_VOICE_ID=alloy
TTS_MODEL_ID=tts-1

# Caching and Rate Limiting
CACHE_ENABLED=false
CACHE_DIR=cache_dir
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=200
CACHE_MAX_AUDIO_BYTES=5000000
RATE_LIMIT_PER_MIN=30
SSL_VERIFY=true
LOG_FILE=
