INTERACTION_EVENT_WEBHOOK_URL=
# Dummy tools return these trusted owner identifiers. Use the same values in
# local evaluation requests so the agent's ownership guard can validate them.
DUMMY_TOOL_USER_ID=evaluation-user
DUMMY_TOOL_TENANT_ID=evaluation-tenant
