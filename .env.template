# Nafi judge-demo configuration
# Copy to .env. The app runs fully in mock mode with every secret left empty.
# Never commit the real .env file.

# -----------------------------------------------------------------------------
# One-command local stack
# -----------------------------------------------------------------------------
WEB_UI_HOST=127.0.0.1
WEB_UI_PORT=3000
USER_INTERACTION_HOST=127.0.0.1
USER_INTERACTION_PORT=8088
AGENTIC_HOST=127.0.0.1
AGENTIC_PORT=8090
NAFI_STARTUP_TIMEOUT_SECONDS=60

# The interaction service calls the bundled agentic service. The agentic
# service itself uses its seeded Saudi-banking simulator until the live API is
# enabled later.
USER_INTERACTION_USE_MOCK_AGENTIC=false
AGENTIC_BASE_URL=http://127.0.0.1:8090
AGENTIC_REQUEST_PATH=/agentic/request
AGENTIC_BACKEND=mock
AGENTIC_WEBHOOK_SECRET=
# Server-only HMAC key for short-lived hosted mock task cookies. Generate a
# random value for deployment; local keyless demo mode has a safe fallback.
NAFI_TASK_SIGNING_SECRET=
AGENTIC_NOTIFICATION_SECRET=

# -----------------------------------------------------------------------------
# Optional OpenAI upgrade for model chat and live voice
# -----------------------------------------------------------------------------
# OPENAI_API_KEY is the only secret needed for both features. If it is empty,
# chat remains deterministic and voice automatically uses the offline demo
# provider. API keys are consumed server-side and must never be sent to the UI.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_CHAT_TIMEOUT_MS=30000
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin

# Turn-based voice fallback (speech-to-text -> Nafi -> text-to-speech).
# auto selects OpenAI when OPENAI_API_KEY is set and mock otherwise.
VOICE_AUDIO_PROVIDER=auto
VOICE_STT_MODEL=gpt-4o-mini-transcribe
VOICE_TTS_MODEL=gpt-4o-mini-tts
VOICE_TTS_VOICE_EN=coral
VOICE_TTS_VOICE_AR=alloy
VOICE_TTS_FORMAT=mp3

# -----------------------------------------------------------------------------
# Security guard
# -----------------------------------------------------------------------------
# Deterministic protection is enabled by default and requires no network.
SECURITY_GUARD_PROVIDER=deterministic
SECURITY_GUARD_REQUIRED=false
SECURITY_GUARD_MODEL=
SECURITY_GUARD_TIMEOUT_SECONDS=20

# Optional legacy OpenRouter guard. Set provider=openrouter plus a key/model to
# use it; leave SECURITY_GUARD_REQUIRED=false to retain deterministic fallback.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_INTENT_MODEL=
OPENROUTER_CHAT_MODEL=
OPENROUTER_REASONING_MODEL=

# -----------------------------------------------------------------------------
# Optional self-hosted PersonaPlex bridge (not required for Nafi live voice)
# -----------------------------------------------------------------------------
HF_TOKEN=
PERSONAPLEX_API_KEY=
PERSONAPLEX_AGENT_ID=
PERSONAPLEX_URL=wss://localhost:8998
PERSONAPLEX_VOICE=NATF2.pt
PERSONAPLEX_TEXT_PROMPT=You are Nafi, a warm bilingual Saudi financial assistant. Never expose internal implementation details.

ARABIC_VOICE_PROVIDER=openai
ARABIC_VOICE_API_KEY=

# -----------------------------------------------------------------------------
# Optional Saudi Open Banking live provider (leave mock values for the demo)
# -----------------------------------------------------------------------------
# Live switch: set mode=live, provider=saudi_open_banking, approval=explicit,
# set AGENTIC_WEBHOOK_SECRET above to a strong shared value, then fill the
# contracted provider values below. Incomplete live startup fails closed and
# reports missing variable names without printing secret values.
AGENTIC_PROVIDER_MODE=mock
AGENTIC_BANKING_PROVIDER=mock
AGENTIC_APPROVAL_MODE=auto_mock

SAUDI_OPEN_BANKING_PROVIDER_ID=contracted-provider-sandbox
SAUDI_OPEN_BANKING_BASE_URL=
SAUDI_OPEN_BANKING_AUTH_MODE=api_key
SAUDI_OPEN_BANKING_API_KEY=
SAUDI_OPEN_BANKING_API_KEY_HEADER=X-API-Key
SAUDI_OPEN_BANKING_ACCESS_TOKEN=

# OAuth application-token profile (only required for oauth auth modes).
SAUDI_OPEN_BANKING_TOKEN_URL=
SAUDI_OPEN_BANKING_CLIENT_ID=
SAUDI_OPEN_BANKING_CLIENT_SECRET=
SAUDI_OPEN_BANKING_TOKEN_CLIENT_AUTH_METHOD=client_secret_basic
SAUDI_OPEN_BANKING_SCOPES=
SAUDI_OPEN_BANKING_AUDIENCE=

# For provider-managed consent, configure an opaque single-user sandbox
# context ID/header. For bearer profiles, ACCESS_TOKEN is the customer-bound
# authorization. Neither value is sent to the planner, browser, logs, or DB.
SAUDI_OPEN_BANKING_CUSTOMER_CONTEXT_ID=
SAUDI_OPEN_BANKING_CUSTOMER_CONTEXT_HEADER=X-Customer-Context-ID

SAUDI_OPEN_BANKING_VERIFY_SSL=true
SAUDI_OPEN_BANKING_ALLOW_INSECURE_HTTP=false
SAUDI_OPEN_BANKING_TIMEOUT_SECONDS=20
SAUDI_OPEN_BANKING_MTLS_REQUIRED=false
SAUDI_OPEN_BANKING_MTLS_CERT_PATH=
SAUDI_OPEN_BANKING_MTLS_KEY_PATH=

SAUDI_OPEN_BANKING_AIS_ENABLED=true
SAUDI_OPEN_BANKING_PIS_ENABLED=true
SAUDI_OPEN_BANKING_BENEFICIARY_WRITE_ENABLED=false
SAUDI_OPEN_BANKING_API_VERSION=
SAUDI_OPEN_BANKING_API_VERSION_HEADER=X-API-Version
SAUDI_OPEN_BANKING_IDEMPOTENCY_HEADER=X-Idempotency-Key
SAUDI_OPEN_BANKING_INTERACTION_HEADER=X-FAPI-Interaction-ID

SAUDI_OPEN_BANKING_ACCOUNTS_PATH=/accounts
SAUDI_OPEN_BANKING_BALANCES_PATH=/accounts/{account_id}/balances
SAUDI_OPEN_BANKING_TRANSACTIONS_PATH=/accounts/{account_id}/transactions
SAUDI_OPEN_BANKING_PAYMENT_PATH=/payments
SAUDI_OPEN_BANKING_PAYMENT_STATUS_PATH=/payments/{payment_id}
SAUDI_OPEN_BANKING_BENEFICIARIES_PATH=/beneficiaries
SAUDI_OPEN_BANKING_BENEFICIARY_PATH=/beneficiaries/{beneficiary_id}

# These are separate partner integrations; Open Banking does not itself
# provide Tadawul brokerage or every bank's savings-product onboarding.
SAUDI_BROKER_BASE_URL=
SAUDI_BROKER_API_KEY=
SAUDI_BANK_PRODUCT_BASE_URL=
SAUDI_BANK_PRODUCT_API_KEY=
