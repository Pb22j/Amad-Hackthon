DATABASE_URL=postgresql+psycopg://amad:development-only-password@localhost:5432/amad
LANGGRAPH_DATABASE_URL=postgresql://amad:development-only-password@localhost:5432/amad
CONFIRMATION_SIGNING_KEY=replace-with-at-least-32-random-bytes
DEMO_CONFIRMATION_OTP=1111
CHECKPOINT_ENCRYPTION_KEY=replace-with-32-byte-random-key!
APP_DATA_ENCRYPTION_KEY=replace-with-at-least-32-random-bytes
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
INTERACTION_SHARED_SECRET=replace-with-at-least-32-random-bytes
# Leave empty for local evaluation; set this when the interaction layer is running.
INTERACTION_EVENT_WEBHOOK_URL=
# Dummy tools return these trusted owner identifiers. Use the same values in
# local evaluation requests so the agent's ownership guard can validate them.
DUMMY_TOOL_USER_ID=user_55219
DUMMY_TOOL_TENANT_ID=evaluation-tenant
# SQLite demo bank. Guarded calls use request-scoped identity; these values are
# only fallbacks for direct tool calls and the local terminal harness.
BANK_DB_PATH=agentic/tools/data/bank.db
BANK_TOOL_USER_ID=evaluation-user
BANK_TOOL_TENANT_ID=evaluation-tenant
