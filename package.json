{
  "name": "nafi",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:web": "NEXT_DIST_DIR=.next-dev next dev",
    "dev:agentic": ".venv/bin/uvicorn main:app --reload --host 127.0.0.1 --port 9000",
    "dev:interaction": "cd VoiceAssistant_Nafea/backend && PYTHONPATH=. ../../.venv/bin/uvicorn app.main:app --reload --host 127.0.0.1 --port 8001",
    "build": "NEXT_DIST_DIR=.next-build next build",
    "start": "next start"
  },
  "dependencies": {
    "lucide-react": "^0.525.0",
    "next": "^15.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
