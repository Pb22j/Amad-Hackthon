# Nafi agentic runtime — this file runs as-is in zero-key mock mode.
AGENTIC_HOST=127.0.0.1
AGENTIC_PORT=8090
AGENTIC_DATABASE_PATH=agentic/data/agentic.sqlite3
# Required (and shared with the interaction layer) before live mode starts.
AGENTIC_REQUEST_WEBHOOK_SECRET=
AGENTIC_INTERACTION_WEBHOOK_SECRET=
INTERACTION_AGENTIC_CALLBACK_URL=
AGENTIC_TASK_RUNNER_ENABLED=true

# Provider selection. Keep both values below for the judge/demo environment.
# To select the live client later, set mode=live, provider=saudi_open_banking,
# approval=explicit, then fill the provider section below.
AGENTIC_PROVIDER_MODE=mock
AGENTIC_BANKING_PROVIDER=mock
AGENTIC_APPROVAL_MODE=auto_mock

# Offline deterministic planner (English and Arabic).
AGENTIC_PLANNER_PROVIDER=heuristic

# ---------------------------------------------------------------------------
# Saudi Open Banking live profile (ignored completely while mode=mock)
# ---------------------------------------------------------------------------
SAUDI_OPEN_BANKING_PROVIDER_ID=contracted-provider-sandbox
SAUDI_OPEN_BANKING_BASE_URL=

# Supported modes:
#   api_key                         (common aggregator/sandbox profile)
#   bearer_token                    (single-user sandbox token)
#   api_key_bearer_token
#   oauth_client_credentials
#   api_key_oauth_client_credentials
SAUDI_OPEN_BANKING_AUTH_MODE=api_key
SAUDI_OPEN_BANKING_API_KEY=
SAUDI_OPEN_BANKING_API_KEY_HEADER=X-API-Key
# Single-user sandbox authorization: use a customer-bound bearer token, or a
# provider-managed consent context for API-key aggregators. Production should
# resolve this per user from a secret/consent store rather than a shared env.
SAUDI_OPEN_BANKING_ACCESS_TOKEN=
SAUDI_OPEN_BANKING_CUSTOMER_CONTEXT_ID=
SAUDI_OPEN_BANKING_CUSTOMER_CONTEXT_HEADER=X-Customer-Context-ID

# OAuth application-token settings (only required by an oauth auth mode).
# A customer consent/SCA token can be passed to the adapter per request and
# always overrides this application token.
SAUDI_OPEN_BANKING_TOKEN_URL=
SAUDI_OPEN_BANKING_CLIENT_ID=
SAUDI_OPEN_BANKING_CLIENT_SECRET=
SAUDI_OPEN_BANKING_TOKEN_CLIENT_AUTH_METHOD=client_secret_basic
SAUDI_OPEN_BANKING_SCOPES=
SAUDI_OPEN_BANKING_AUDIENCE=

# Provider transport/security. HTTPS verification is on by default.
SAUDI_OPEN_BANKING_VERIFY_SSL=true
SAUDI_OPEN_BANKING_ALLOW_INSECURE_HTTP=false
SAUDI_OPEN_BANKING_TIMEOUT_SECONDS=20
SAUDI_OPEN_BANKING_MTLS_REQUIRED=false
SAUDI_OPEN_BANKING_MTLS_CERT_PATH=
SAUDI_OPEN_BANKING_MTLS_KEY_PATH=

# Truthful contracted-provider capabilities. Beneficiary write is off unless
# the selected provider explicitly supports it.
SAUDI_OPEN_BANKING_AIS_ENABLED=true
SAUDI_OPEN_BANKING_PIS_ENABLED=true
SAUDI_OPEN_BANKING_BENEFICIARY_WRITE_ENABLED=false

# Provider-specific version and header names.
SAUDI_OPEN_BANKING_API_VERSION=
SAUDI_OPEN_BANKING_API_VERSION_HEADER=X-API-Version
SAUDI_OPEN_BANKING_IDEMPOTENCY_HEADER=X-Idempotency-Key
SAUDI_OPEN_BANKING_INTERACTION_HEADER=X-FAPI-Interaction-ID

# Provider-specific endpoint map. Paths are relative to BASE_URL and preserve
# base prefixes such as /open-banking/v1. Template values are URL-encoded.
SAUDI_OPEN_BANKING_ACCOUNTS_PATH=/accounts
SAUDI_OPEN_BANKING_BALANCES_PATH=/accounts/{account_id}/balances
SAUDI_OPEN_BANKING_TRANSACTIONS_PATH=/accounts/{account_id}/transactions
SAUDI_OPEN_BANKING_PAYMENT_PATH=/payments
SAUDI_OPEN_BANKING_PAYMENT_STATUS_PATH=/payments/{payment_id}
SAUDI_OPEN_BANKING_BENEFICIARIES_PATH=/beneficiaries
SAUDI_OPEN_BANKING_BENEFICIARY_PATH=/beneficiaries/{beneficiary_id}

# Separate regulated/partner integrations; Open Banking does not itself cover
# Tadawul brokerage or opening every bank savings product.
SAUDI_BROKER_BASE_URL=
SAUDI_BROKER_API_KEY=
SAUDI_BANK_PRODUCT_BASE_URL=
SAUDI_BANK_PRODUCT_API_KEY=
