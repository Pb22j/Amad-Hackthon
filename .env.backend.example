# Shared runtime configuration for both Python backend services.
# Copy to .env.backend and replace every placeholder before real-provider tests.

# Runtime and service addresses
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8001
AGENTIC_BASE_URL=http://127.0.0.1:9000
INTERACTION_EVENT_WEBHOOK_URL=http://127.0.0.1:8001/api/webhook
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Unified PostgreSQL cluster
DATABASE_URL=postgresql+psycopg://amad:development-only-password@localhost:55432/amad
LANGGRAPH_DATABASE_URL=postgresql://amad:development-only-password@localhost:55432/amad
BANK_DATABASE_URL=postgresql://amad:development-only-password@localhost:55432/amad
INTERACTION_DATABASE_URL=postgresql://amad:development-only-password@localhost:55432/amad

# Shared security boundary (replace all values; do not reuse keys)
INTERACTION_SHARED_SECRET=replace-with-at-least-32-random-bytes
CONFIRMATION_SIGNING_KEY=replace-with-different-32-random-bytes
CHECKPOINT_ENCRYPTION_KEY=replace-with-32-byte-random-key!
APP_DATA_ENCRYPTION_KEY=replace-with-separate-32-random-bytes
INTERACTION_DATA_ENCRYPTION_KEY=replace-with-another-32-random-key
DEMO_CONFIRMATION_OTP=1111
INTERACTION_TIMESTAMP_TOLERANCE_SECONDS=300
AGENTIC_TIMEOUT_SECONDS=120
SSL_VERIFY=true

# Model and speech providers
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
NVIDIA_API_KEY=
STT_PROVIDER=openai
LLM_PROVIDER=openai
TTS_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_SYSTEM_PROMPT="You are a friendly, concise financial voice assistant."
REALTIME_MODEL=gemini-3.1-flash-live-preview
REALTIME_VOICE=Charon
TTS_VOICE_ID=alloy
TTS_MODEL_ID=tts-1

# Server-owned demo identity and financial tools
DEMO_USER_ID=evaluation-user
DEMO_TENANT_ID=evaluation-tenant
DEMO_SCOPES=financial:read,financial:write,investment:trade
DUMMY_TOOL_USER_ID=evaluation-user
DUMMY_TOOL_TENANT_ID=evaluation-tenant
BANK_TOOL_USER_ID=evaluation-user
BANK_TOOL_TENANT_ID=evaluation-tenant
AGENTIC_TOOL_PROVIDER=
SESSION_TTL_SECONDS=3600
SESSION_COOKIE_SECURE=false

# Voice memory, payload, cache, and rate limits
VOICE_MEMORY_MAX_USER_TURNS=12
VOICE_MEMORY_MAX_ASSISTANT_TURNS=6
VOICE_MEMORY_CONTEXT_TURNS=8
VOICE_MEMORY_MAX_TEXT_CHARACTERS=2000
VOICE_MEMORY_CONTEXT_MAX_CHARACTERS=6000
# Keep live conversations responsive by compacting well before the model's full window.
VOICE_CONTEXT_TRIGGER_TOKENS=12000
VOICE_CONTEXT_TARGET_TOKENS=6000
VOICE_REALTIME_MAX_TEXT_CHARACTERS=8000
MAX_AUDIO_BYTES=10000000
CACHE_ENABLED=false
CACHE_DIR=cache_dir
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=200
CACHE_MAX_AUDIO_BYTES=5000000
RATE_LIMIT_PER_MIN=30
LOG_FILE=

# Standalone evaluation client
AGENTIC_EVALUATION_USER_ID=evaluation-user
AGENTIC_EVALUATION_TENANT_ID=evaluation-tenant
AGENTIC_EVALUATION_TIMEOUT_SECONDS=180
